  ],
  "workflow": [
    "SIGNAL_CAPTURE",
    "LINK_HYPOTHESIS",
    "INDEPENDENT_REALITY_CHECK",
    "EVIDENCE_STATE_CLASSIFICATION",
    "CONFIDENCE_CALIBRATION",
    "CONTRARY_EVIDENCE_AND_ALTERNATIVES",
    "DECISIVE_TEST",
    "HARM_AND_PRIORITY",
    "COMPETENCE_ROUTING",
    "SECOND_PAIR_REVIEW",
    "HUMAN_DECISION",
    "ACTION_OR_NO_ACTION",
    "PERIODIC_REVIEW_AND_CORRECTION"
  ],
  "required_analysis_fields": [
    "signal_id",
    "source_record_ids",
    "subject_refs",
    "signal_description",
    "link_hypothesis",
    "link_basis",
    "independent_verification",
    "registry_or_record_vs_reality",
    "evidence_state",
    "confidence_term",
    "confidence_basis",
    "contrary_evidence",
    "innocent_or_alternative_explanations",
    "decisive_test",
    "what_would_change_status",
    "harm_and_risk",
    "seriality_or_pattern",
    "cooperation_state",
    "competence_route",
    "four_p_lane",
    "review_state",
    "human_decision",
    "decision_reasons",
    "review_date_or_trigger",
    "status_change_log",
    "authoritative_data_state",
    "source_independence_state",
    "control_assessment",
    "residual_risk",
    "case_packet_completeness",
    "annotation_or_correction_state",
    "review_cadence_or_trigger"
  ],
  "confidence_vocabulary": {
    "source": "PHIA Probability Yardstick as used by Companies House",
    "communication_only_not_computed_probability": true,
    "terms": [
      {
        "term": "REMOTE_CHANCE",
        "approximate_range": ">0% to <5%"
      },
      {
        "term": "HIGHLY_UNLIKELY",
        "approximate_range": "10% to 20%"
      },
      {
        "term": "UNLIKELY",
        "approximate_range": "25% to 35%"
      },
      {
        "term": "REALISTIC_POSSIBILITY",
        "approximate_range": "40% to <50%"
      },
      {
        "term": "LIKELY_OR_PROBABLY",
        "approximate_range": "55% to 75%"
      },
      {
        "term": "HIGHLY_LIKELY",
        "approximate_range": "80% to 90%"
      },
      {
        "term": "ALMOST_CERTAIN",
        "approximate_range": "95% to <100%"
      },
      {
        "term": "NOT_ASSESSED",
        "approximate_range": null
      }
    ],
    "rule": "Confidence is separate from evidence state. A high-confidence inference is still an inference unless the underlying proposition is independently established."
  },
  "cooperation_states": [
    "NOT_REQUESTED",
    "REQUESTED_AWAITING_RESPONSE",
    "COOPERATING",
    "PARTIAL_RESPONSE",
    "NON_COOPERATION_DOCUMENTED",
    "NOT_APPLICABLE",
    "UNKNOWN"
  ],
  "four_p_mapping": {
    "PREPARE": "Preserve sources, define the threat/problem, maintain schemas, identify gaps and build the entity-event graph.",
    "PREVENT": "Correct or flag unreliable records, stop avoidable propagation, surface contradictions early and improve data quality.",
    "PURSUE": "Use targeted evidence requests, competent referral or another authorised investigation/enforcement route when thresholds are met.",
    "PROTECT": "Protect innocent stakeholders, the integrity of the record, procedural fairness, privacy, rights of reply and recoverability of evidence."
  },
  "guardrails": {
    "signal_is_not_finding": true,
    "link_is_not_participation": true,
    "association_does_not_transfer_knowledge_intent_control_or_liability": true,
    "registry_entry_is_not_real_world_verification": true,
    "repetition_is_not_corroboration_without_source_independence": true,
    "chronology_is_not_causation": true,
    "non_cooperation_is_not_guilt": true,
    "missing_record_is_not_proof_of_nonexistence": true,
    "contrary_evidence_must_remain_visible": true,
    "competence_and_legal_power_must_be_checked_before_referral": true,
    "duplicate_evidence_requests_should_be_minimised": true,
    "human_decision_required_for_external_action": true,
    "independent_or_second_pair_review_should_be_recorded_where_practicable": true,
    "self_review_only_must_be_disclosed_when_no_independent_reviewer_is_available": true,
    "no_institutional_endorsement_claimed": true,
    "does_not_activate_new_ci_hard_gate": true,
    "chatgpt_or_drive_memory_is_not_source_authority": true,
    "technical_comparator_does_not_ingest_foreign_case_actors": true,
    "annotation_is_not_finding": true,
    "residual_risk_is_not_guilt_score": true
  },
  "priority_factors": [
    "actual_or_potential_harm",
    "seriousness",
    "repetition_or_seriality",
    "apparent_intent_or_wilfulness_when_source_supported",
    "number_and_vulnerability_of_affected_people_or_entities",
    "ongoing_or_irreversible_effect",
    "availability_of_a_decisive_test",
    "competence_and_practicality_of_action",
    "wider_public_interest",
    "resource_proportionality"
  ],
  "review_outcomes": [
    "CLEAR_NO_FURTHER_ACTION",
    "KEEP_OPEN_SOURCE_GAP",
    "VERIFY_FURTHER",
    "NARROW_SCOPE",
    "CORRECT_OR_RECTIFY_RECORD",
    "ESCALATE_WITHIN_COMPETENCE",
    "REFER_TO_COMPETENT_BODY",
    "PRESERVE_AND_MONITOR",
    "SUPERSEDED_BY_NEW_EVIDENCE"
  ],
  "metrics": [
    "time_to_decisive_test",
    "signals_cleared_without_escalation",
    "hypotheses_changed_by_contrary_evidence",
    "duplicate_requests_avoided",
    "records_corrected_or_status_updated",
    "referrals_with_complete_source_pack",
    "reviews_completed_or_self_review_limitation_recorded"
  ],
  "integration_pass": "2026-09-25",
  "compatibility": {
    "cross_cutting_layer": true,
    "replaces_existing_evidence_state": false,
    "replaces_second_pair_of_eyes": false,
    "replaces_case_interlink_controls": false,
    "no_competing_master_architecture": true
  },
  "authoritative_data_states": [
    "SOURCE_LOCKED",
    "UNDER_CHECK",
    "CONCERN_FLAGGED",
    "CORRECTED",
    "SUPERSEDED",
    "OPEN_GAP",
    "CLEAR_WITHIN_SCOPE"
  ],
  "source_independence_states": [
    "SAME_ORIGIN",
    "DERIVATIVE_OR_FORWARD",
    "PARTIALLY_INDEPENDENT",
    "INDEPENDENT",
    "UNKNOWN",
    "NOT_APPLICABLE"
  ],
  "control_assessment": {
    "control_types": [
      "PREVENTIVE",
      "DETECTIVE",
      "CORRECTIVE"
    ],
    "existence_states": [
      "PRESENT",
      "PARTIAL",
      "ABSENT",
      "UNKNOWN",
      "NOT_APPLICABLE"
    ],
    "effectiveness_states": [
      "EFFECTIVE",
      "PARTLY_EFFECTIVE",
      "INEFFECTIVE",
      "NOT_TESTED",
      "UNKNOWN"
    ],
    "required_fields": [
      "control_objective",
      "control_type",
      "existence_state",
      "effectiveness_state",
      "limitations",
      "residual_risk",
      "owner_or_competent_maintainer",
      "mitigation_or_next_test",
      "review_trigger"
    ],
    "guardrail": "Residual risk is a systems-management statement, not a guilt, credibility or culpability score."
  },
  "case_packet_minimum": [
    "question_and_perimeter",
    "source_and_custody_map",
    "source_independence_map",
    "identity_capacity_date_map",
    "chronology_and_knowledge_chronology",
    "proposition_evidence_state_matrix",
    "record_vs_reality_comparison",
    "support_contrary_correction_and_alternative",
    "decisive_test_or_finite_gap",
    "institutional_handling_state_if_relevant",
    "control_assessment_if_relevant",
    "priority_rationale",
    "competence_route_and_minimum_reusable_pack",
    "second_pair_challenge",
    "human_decision_reasons_and_reopen_trigger"
  ],
  "additional_metrics": [
    "material_edges_with_source_independence_state",
    "high_priority_propositions_with_finite_decisive_test",
    "stale_reviews_or_propositions",
    "corrections_propagated_to_all_affected_derivatives",
    "concern_flags_cleared_after_review",
    "handoffs_with_competence_finite_request_and_contrary_evidence",
    "recurring_failure_modes_with_documented_controls"
  ],
  "integration_targets": [
    "second_pair_of_eyes",
    "context_integrity_truth_inversion",
    "institutional_decision_accountability",
    "evidence_intelligence",
    "case_interlink",
    "missing_evidence_gap_control",
    "institutional_communications_and_action",
    "unitary_action_programme"
  ]
}
