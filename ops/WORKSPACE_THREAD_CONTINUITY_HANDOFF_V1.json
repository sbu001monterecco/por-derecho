  "deletion_safe_requirements": [
    "no material instruction known to remain chat-only",
    "unique decisions are durable",
    "open gaps are explicit",
    "branch/PR/main state is explicit",
    "volatile outputs are registered or named as gaps",
    "failed operations are recorded",
    "bootstrap prompt is sufficient",
    "canonical controls are linked instead of inaccurately duplicated"
  ],
  "anti_patterns": [
    "treat chat history as canonical source",
    "say done without state qualification",
    "re-run full repository scan by default",
    "infer that branch-only work is merged",
    "infer that merged means live",
    "infer that public means filed or served",
    "infer failed generation produced a file",
    "silently replace artifact hashes or references"
