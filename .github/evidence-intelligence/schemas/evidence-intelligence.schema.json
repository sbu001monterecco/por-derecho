{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://por-derecho.example/schemas/evidence-intelligence.schema.json",
  "title": "Por Derecho evidence-intelligence public-safe objects",
  "type": "object",
  "$defs": {
    "identityRef": {
      "type": "string",
      "pattern": "^PD-SP-(P|O|S|I|R)-[0-9]{4}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "extendedId": {
      "type": "string",
      "pattern": "^PD-SP-(SRC|DOC|MAT|EVT|PROP|ASSET|RIGHT|REC|CIT|EVAL|CUST|RUN)-[0-9]{4}$"
    },
    "publicDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "proceeding_ids", "source_class", "sha256", "bytes", "pages", "evidence_state", "publication_state", "limitations"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^PD-SP-DOC-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 3},
        "proceeding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identityRef"}},
        "source_class": {"enum": ["PD_NATIVE_PRIVATE", "PD_PUBLIC_EVIDENCE", "PD_CURATED_ANALYSIS", "PUBLIC_EXTERNAL_SOURCE", "EXTERNAL_COMPARATOR", "TECHNICAL_REFERENCE", "FOREIGN_MATTER_EXCLUDED"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "pages": {"type": "integer", "minimum": 1},
        "evidence_state": {"type": "string", "minLength": 3},
        "publication_state": {"enum": ["PRIVATE_NATIVE_PUBLIC_HASH_ONLY", "PUBLIC_EVIDENCE", "PUBLIC_DERIVATIVE", "NOT_FOR_PUBLICATION"]},
        "private_manifest_ref": {"type": "string", "pattern": "^PD-SP-CUST-[0-9]{4}$"},
        "related_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PD-SP-DOC-[0-9]{4}$"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "document_id", "page_start", "page_end", "source_version"],
      "properties": {
        "citation_id": {"type": "string", "pattern": "^PD-SP-CIT-[0-9]{4}$"},
        "document_id": {"type": "string", "pattern": "^PD-SP-DOC-[0-9]{4}$"},
        "page_start": {"type": "integer", "minimum": 1},
        "page_end": {"type": "integer", "minimum": 1},
        "paragraph_start": {"type": "integer", "minimum": 1},
        "paragraph_end": {"type": "integer", "minimum": 1},
        "character_start": {"type": "integer", "minimum": 0},
        "character_end": {"type": "integer", "minimum": 0},
        "quoted_text_hash": {"$ref": "#/$defs/sha256"},
        "source_version": {"type": "string", "minLength": 3}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "proceeding_id", "question", "top_k", "expected_any"],
      "properties": {
        "evaluation_id": {"type": "string", "pattern": "^PD-SP-EVAL-[0-9]{4}$"},
        "proceeding_id": {"$ref": "#/$defs/identityRef"},
        "question": {"type": "string", "minLength": 8},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 20},
        "expected_any": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "required_text": {"type": "array", "items": {"type": "string", "minLength": 2}},
        "forbidden_text": {"type": "array", "items": {"type": "string", "minLength": 2}}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/publicDocument"},
    {"$ref": "#/$defs/citation"},
    {"$ref": "#/$defs/evaluation"}
  ]
}
