{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbu001monterecco.github.io/por-derecho/.github/evidence-intelligence/schemas/evidence-visibility.schema.json",
  "title": "Por Derecho evidence visibility package",
  "description": "Repository contract for native preservation, searchable text, source-derived evidence images, redaction and continuity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "title",
    "scope",
    "governance",
    "role_continuity",
    "records"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 3,
      "pattern": "^(?!https?://).+"
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "language"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "type": "string",
          "minLength": 3
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_end": {
          "type": "integer",
          "minimum": 1
        },
        "caption": {
          "type": "string",
          "minLength": 3
        },
        "redacted": {
          "type": "boolean"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "status",
        "description",
        "next_action",
        "owner_role"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "minLength": 4
        },
        "status": {
          "enum": [
            "OPEN",
            "BLOCKED",
            "RESOLVED"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 8
        },
        "next_action": {
          "type": "string",
          "minLength": 8
        },
        "owner_role": {
          "enum": [
            "Worker",
            "Integrator",
            "Verifier",
            "Publication Coordinator",
            "Continuity / closeout role"
          ]
        },
        "blocking_reason": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "title",
        "document_type",
        "source_date",
        "languages",
        "source_type",
        "lifecycle_status",
        "provenance",
        "original_asset",
        "searchable_text",
        "visual_evidence",
        "redaction",
        "relations",
        "publication",
        "gaps"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^PD-EVIS-[A-Z0-9-]{4,}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "document_type": {
          "type": "string",
          "minLength": 3
        },
        "source_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "source_type": {
          "enum": [
            "PD_NATIVE_PRIVATE",
            "PD_PUBLIC_EVIDENCE",
            "PD_CURATED_ANALYSIS",
            "PUBLIC_EXTERNAL_SOURCE",
            "CONNECTED_SOURCE",
            "PHYSICAL_SOURCE",
            "SOURCE_NOT_YET_RECOVERED"
          ]
        },
        "lifecycle_status": {
          "enum": [
            "SOURCE_PENDING",
            "SOURCE_PRESERVED",
            "TEXT_EXTRACTED",
            "IMAGE_RENDERED",
            "REDACTED_PUBLIC_DERIVATIVE",
            "LINKED",
            "LIVE_VERIFIED",
            "BLOCKED_WITH_REASON"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "custodian_class",
            "source_description",
            "verified_or_registered_date",
            "integrity_note"
          ],
          "properties": {
            "custodian_class": {
              "type": "string",
              "minLength": 3
            },
            "source_description": {
              "type": "string",
              "minLength": 8
            },
            "verified_or_registered_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "integrity_note": {
              "type": "string",
              "minLength": 8
            },
            "parent_evidence_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "variant_of": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "original_asset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "filename",
            "repository_path",
            "sha256",
            "size_bytes",
            "pages_or_duration",
            "source_reference"
          ],
          "properties": {
            "status": {
              "enum": [
                "PRESERVED_IN_REPOSITORY",
                "PRESERVED_EXTERNAL_CONNECTED_SOURCE",
                "SOURCE_PENDING",
                "NOT_APPLICABLE"
              ]
            },
            "filename": {
              "type": [
                "string",
                "null"
              ]
            },
            "repository_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "size_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "pages_or_duration": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_reference": {
              "type": [
                "string",
                "null"
              ]
            },
            "identity_status": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "searchable_text": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "method",
            "assets",
            "limitations"
          ],
          "properties": {
            "status": {
              "enum": [
                "PUBLISHED",
                "PARTIAL",
                "PENDING",
                "NOT_APPLICABLE"
              ]
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "assets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/assetRef"
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        },
        "visual_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "images",
            "rendering_rule",
            "limitations"
          ],
          "properties": {
            "status": {
              "enum": [
                "PUBLISHED",
                "PARTIAL",
                "SOURCE_PENDING",
                "BLOCKED_WITH_REASON",
                "NOT_APPLICABLE"
              ]
            },
            "images": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/assetRef"
              }
            },
            "rendering_rule": {
              "type": "string",
              "minLength": 8
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "sensitivity_level",
            "public_version_of",
            "method",
            "review"
          ],
          "properties": {
            "status": {
              "enum": [
                "NONE",
                "PUBLIC_REDACTED_DERIVATIVE",
                "REDACTION_REQUIRED",
                "NOT_ASSESSED"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "sensitivity_level": {
              "enum": [
                "PUBLIC",
                "PUBLIC_REDACTED",
                "REVIEW_REQUIRED",
                "RESTRICTED"
              ]
            },
            "public_version_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reviewer_role",
                "review_date"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "NOT_REQUIRED",
                    "PENDING",
                    "APPROVED",
                    "REJECTED"
                  ]
                },
                "reviewer_role": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "review_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          }
        },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actors",
            "entities",
            "proceedings",
            "events",
            "pages",
            "parent_child"
          ],
          "properties": {
            "actors": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "entities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "proceedings": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "events": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "pages": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "parent_child": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "public_routes",
            "evidence_page",
            "live_verified",
            "deployed_commit"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_PUBLISHED",
                "REGISTERED",
                "PUBLISHED",
                "LIVE_VERIFIED",
                "BLOCKED_WITH_REASON"
              ]
            },
            "public_routes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "evidence_page": {
              "type": [
                "string",
                "null"
              ]
            },
            "live_verified": {
              "type": "boolean"
            },
            "deployed_commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^PD-EVIS-[A-Z0-9-]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "scope": {
      "type": "string",
      "minLength": 8
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "policy_path",
        "schema_path",
        "visual_completeness_claim"
      ],
      "properties": {
        "control_id": {
          "const": "PD-EVIS-20260904-01"
        },
        "policy_path": {
          "$ref": "#/$defs/path"
        },
        "schema_path": {
          "$ref": "#/$defs/path"
        },
        "visual_completeness_claim": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "NOT_STARTED",
            "BLOCKED"
          ]
        }
      }
    },
    "role_continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_owner_role",
        "next_owner_role",
        "handoff_status",
        "open_gap_count"
      ],
      "properties": {
        "current_owner_role": {
          "type": "string",
          "minLength": 3
        },
        "next_owner_role": {
          "type": "string",
          "minLength": 3
        },
        "handoff_status": {
          "enum": [
            "ACTIVE",
            "READY",
            "BLOCKED",
            "CLOSED"
          ]
        },
        "open_gap_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  }
}
