{
  "schema": "por-derecho.ministerio-fiscal-canonical-cross-register.v1",
  "control_date": "2026-09-19",
  "status": "SOURCE_CONTROLLED_CROSS_REGISTER_WITH_EXPLICIT_GAPS",
  "purpose": "Canonical cross-register for every Ministerio Fiscal office/entity, named prosecutor, file, event and evidence item currently mentioned or source-controlled in the Sun Park / Por Derecho perimeter. It extends existing identifiers without renumbering them.",
  "identity_policy": {
    "offices": "Reuse existing PD-MF-OFF-#### identifiers from assets/data/ministerio-fiscal-directory-v1.json. New offices may append only; never renumber.",
    "entities": "PD-MF-ENT-#### identifies an institutional/specialist entity or functional delegation in this cross-register; it is not an official Ministerio Fiscal identifier.",
    "people": "PD-MF-PER-#### is the cross-register identity. existing_caepr_id preserves any controlling PD-SP-P-#### identity already present in the justice-professionals registry.",
    "files": "Existing Master_ID values remain controlling. PD-MF-FIL-#### is used only when a referenced file lacks a reconciled Master_ID.",
    "events": "PD-MF-REG-EVT-#### is this register's stable event reference. A global PD-SP-EVT identity, REGAGE, DI, DIP, EG or NIG remains separate.",
    "evidence": "PD-MF-EVD-#### identifies a source/evidence object. Private-provider locators and Gmail message IDs are never published here."
  },
  "proof_boundaries": [
    "Office membership or hierarchical position does not establish personal knowledge, handling or agreement with another prosecutor's act.",
    "A registration receipt proves presentation/routing metadata stated on the receipt, not merits review, joinder, admission or investigation.",
    "A signed decree proves issuance, signatory and stated reasoning/outcome within its scope; it does not prove complete expediente contents, correctness, motive or criminality.",
    "Complaints, ampliaciones and party statements remain allegations unless independently established.",
    "Specialist relevance is a competence/coordination map, not a finding that a specialist unit accepted jurisdiction or the allegations."
  ],
  "gitlab_mirror_control": {
    "state": "PENDING_GITLAB_ACCOUNT_RESTORATION",
    "canonical_repository_rule": "GitLab main remains the controlling repository when access is restored; GitHub changes must be reconciled against the then-current GitLab main before propagation.",
    "queue_path": "archive/MINISTERIO_FISCAL_GITLAB_RESTORE_MIRROR_QUEUE_19SEP2026.md",
    "no_blind_overwrite": true
  },
