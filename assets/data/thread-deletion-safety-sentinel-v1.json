{
  "schema": "por-derecho.thread-deletion-safety-sentinel.v1",
  "control_id": "PD-THREAD-SENTINEL-20260925-01",
  "default_state": "ORANGE",
  "visible_cues": {
    "GREEN": "🟢 THREAD — safe to delete",
    "ORANGE": "🟠 THREAD — preservation pending",
    "RED": "🔴 THREAD — do not delete"
  },
  "states": {
    "GREEN": {
      "deletion_allowed": true,
      "meaning": "Material continuity is independently reconstructable and no chat-bound operational dependency would be interrupted.",
      "required": [
        "NO_UNIQUE_CHAT_ONLY_MATERIAL",
        "MATERIAL_PROPAGATION_COMPLETE",
        "DURABLE_PRIVATE_CONTROL_READBACK",
        "REMOTE_SOURCE_RECOVERABLE",
        "OPEN_WORK_DURABLY_RECORDED",
        "NO_CHAT_BOUND_ACTIVE_OPERATION",
        "PUBLICATION_LIVE_VERIFIED_IF_APPLICABLE"
      ]
    },
    "ORANGE": {
      "deletion_allowed": false,
      "meaning": "Continuity may be recoverable, but deletion safety is not fully certified.",
      "recommended_action": "ARCHIVE_NOT_DELETE"
    },
    "RED": {
      "deletion_allowed": false,
      "meaning": "Deletion would credibly cause material loss, interruption or orphaning.",
      "hard_triggers": [
        "UNIQUE_CHAT_ONLY_MATERIAL",
        "CHAT_BOUND_AUTOMATION_OR_TASK",
        "UNPRESERVED_EXTERNAL_ACTION_RECEIPT",
        "CHAT_ONLY_RECOVERY_INSTRUCTION",
        "EXPIRED_SOURCE_NOT_REACQUIRED_AND_CHAT_IS_ONLY_USABLE_COPY",
        "LOCAL_ONLY_MATERIAL_WORK"
      ]
    }
  },
  "reassess_on": [
    "MATERIAL_SOURCE_CHANGE",
    "EXTERNAL_ACTION",
    "REPOSITORY_WRITE_OR_MERGE",
    "DRIVE_WRITE",
    "AUTOMATION_CHANGE",
    "MATERIAL_CORRECTION",
    "PRESERVATION_GATE_RESULT",
    "SOURCE_ACCESS_OR_EXPIRY_CHANGE",
    "DELETION_QUERY",
    "THREAD_CLOSEOUT"
  ],
  "evidence_precedence": [
    "NATIVE_SOURCE_OR_TASK_STATE",
    "CURRENT_REMOTE_REPOSITORY_STATE",
    "PRIVATE_DRIVE_CONTROL_READBACK",
    "CURRENT_CHAT_ASSERTION"
  ],
  "privacy": {
    "public_git": "policy_schema_validator_and_public_safe_closeout_only",
    "private_drive": "source_locators_active_dependencies_and_sensitive_closeout",
    "raw_chat_replication": "not_required_and_disfavoured"
  },
  "product_boundary": {
    "native_chatgpt_badge_available": false,
    "substitute": "MANDATORY_COMPACT_RESPONSE_FOOTER"
  }
}
