{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbu001monterecco.github.io/por-derecho/schemas/workspace-state-v1.schema.json",
  "title": "Por Derecho workspace state v1",
  "type": "object",
  "required": [
    "schema",
    "workspace_id",
    "title",
    "status",
    "visibility_class",
    "objective",
    "created_at_utc",
    "updated_at_utc",
    "event_count",
    "repository_state",
    "completed",
    "decisions",
    "open_tasks",
    "next_actions",
    "do_not_infer",
    "artifact_refs",
    "source_refs",
    "thread_aliases"
  ],
  "properties": {
    "schema": {
      "const": "por-derecho.workspace-state.v1"
    },
    "workspace_id": {
      "pattern": "^PD-WS-[0-9]{8}-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "IN_PROGRESS",
        "HANDOFF_READY",
        "DELETION_SAFE",
        "DELETION_SAFE_WITH_OPEN_WORK",
        "PAUSED",
        "SUPERSEDED",
        "CLOSED"
      ]
    },
    "visibility_class": {
      "enum": [
        "PUBLIC_SOURCE_SAFE",
        "PUBLIC_DERIVED_SAFE",
        "PRIVATE_WORKSPACE",
        "CONFIDENTIAL_USER_SUPPLIED",
        "CONNECTED_SOURCE_RESTRICTED",
        "PUBLICATION_REVIEW_REQUIRED"
      ]
    },
    "objective": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "event_count": {
      "type": "integer",
      "minimum": 1
    },
    "last_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_event_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_state": {
      "type": "object"
    },
    "thread_aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "do_not_infer": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": [
        "object",
        "null"
      ]
    },
    "publication_state": {
      "type": "object"
    },
    "tool_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "checkpoint_contract": {
      "const": "PD-CONT-DIGEST-001/20261002"
    },
    "action_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chronology_and_proceedings_actions",
        "completed_actions",
        "connected_source_actions",
        "do_not_infer",
        "open_actions",
        "publication_and_live_actions",
        "registration_and_identity_actions",
        "relationship_interlink_actions",
        "repository_digest_actions",
        "next_thread_bootstrap"
      ],
      "properties": {
        "publication_and_live_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relationship_interlink_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repository_digest_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "chronology_and_proceedings_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connected_source_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "registration_and_identity_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "do_not_infer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_thread_bootstrap": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "status",
        "inspected",
        "remaining",
        "observed_at_utc"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "BOUNDED_COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_REVIEWED"
          ]
        },
        "inspected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "remaining": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "host_availability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host_id",
          "status",
          "checked_at_utc",
          "boundary"
        ],
        "properties": {
          "host_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "NOT_CHECKED",
              "READ_ONLY",
              "UNAVAILABLE"
            ]
          },
          "checked_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "public_summary_approval": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "authority_ref",
        "approved_at_utc",
        "summary_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPROVED",
            "REVOKED"
          ]
        },
        "scope": {
          "const": "EXACT_PUBLIC_SUMMARY"
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "approved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "summary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "checkpoint_contract"
        ],
        "properties": {
          "checkpoint_contract": {
            "const": "PD-CONT-DIGEST-001/20261002"
          }
        }
      },
      "then": {
        "required": [
          "action_ledger",
          "coverage",
          "host_availability"
        ]
      }
    }
  ]
}
