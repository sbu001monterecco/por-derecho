# Server-side only. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Leave blank to use the standard API. Set only to the regional base for an OpenAI project actually configured for that region.
OPENAI_BASE_URL=https://api.openai.com/v1
# Canonical public-record site used for source retrieval.
PSR_PUBLIC_BASE=https://sbu001monterecco.github.io/por-derecho
# Additional comma-separated front-end origins, if any.
PSR_ALLOWED_ORIGINS=
# Required only for the private aggregate insights endpoint.
CHAT_ANALYTICS_ADMIN_TOKEN=
